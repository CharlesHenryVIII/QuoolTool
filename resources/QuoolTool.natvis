<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="gbVec2&lt;*&gt;">
    <DisplayString>{x}, {y}</DisplayString>
  </Type>

  <Type Name="gbVec3&lt;*&gt;">
    <DisplayString>{x}, {y}, {z}</DisplayString>
  </Type>

  <Type Name="gbVec4&lt;*&gt;">
    <DisplayString>{x}, {y}, {z}, {w}</DisplayString>
  </Type>

  <Type Name="gbQuat&lt;*&gt;">
    <DisplayString>{x}, {y}, {z}, {w}</DisplayString>
  </Type>

  <Type Name="gbMat2&lt;*&gt;">
    <DisplayString>{col[0].x}, {col[0].y} | {col[1].x}, {col[1].y} | {col[2].x}, {col[2].y} | {col[3].x}, {col[3].y}</DisplayString>
    <Expand>
      <Synthetic Name="[Row 0]">
        <DisplayString>{col[0].e[0]}, {col[0].e[1]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 1]">
        <DisplayString>{col[1].e[0]}, {col[1].e[1]}</DisplayString>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="gbMat3&lt;*&gt;">
    <DisplayString>{col[0].x}, {col[0].y}, {col[0].z} | {col[1].x}, {col[1].y}, {col[1].z} | {col[2].x}, {col[2].y}, {col[2].z} | {col[3].x}, {col[3].y}, {col[3].z}</DisplayString>
    <Expand>
      <Synthetic Name="[Row 0]">
        <DisplayString>{col[0].e[0]}, {col[0].e[1]}, {col[0].e[2]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 1]">
        <DisplayString>{col[1].e[0]}, {col[1].e[1]}, {col[1].e[2]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 2]">
        <DisplayString>{col[2].e[0]}, {col[2].e[1]}, {col[2].e[2]}</DisplayString>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="gbMat4x3&lt;*&gt;">
    <DisplayString>{col[0].x}, {col[0].y}, {col[0].z}, {col[0].w} | {col[1].x}, {col[1].y}, {col[1].z}, {col[1].w} | {col[2].x}, {col[2].y}, {col[2].z}, {col[2].w}</DisplayString>
    <Expand>
      <Synthetic Name="[Row 0]">
        <DisplayString>{col[0].e[0]}, {col[0].e[1]}, {col[0].e[2]}, {col[0].e[3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 1]">
        <DisplayString>{col[1].e[0]}, {col[1].e[1]}, {col[1].e[2]}, {col[1].e[3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 2]">
        <DisplayString>{col[2].e[0]}, {col[2].e[1]}, {col[2].e[2]}, {col[2].e[3]}</DisplayString>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="gbMat4&lt;*&gt;">
    <DisplayString>{col[0].x}, {col[0].y}, {col[0].z}, {col[0].w} | {col[1].x}, {col[1].y}, {col[1].z}, {col[1].w} | {col[2].x}, {col[2].y}, {col[2].z}, {col[2].w} | {col[3].x}, {col[3].y}, {col[3].z}, {col[3].w}</DisplayString>
    <Expand>
      <Synthetic Name="[Row 0]">
        <DisplayString>{col[0].e[0]}, {col[0].e[1]}, {col[0].e[2]}, {col[0].e[3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 1]">
        <DisplayString>{col[1].e[0]}, {col[1].e[1]}, {col[1].e[2]}, {col[1].e[3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 2]">
        <DisplayString>{col[2].e[0]}, {col[2].e[1]}, {col[2].e[2]}, {col[2].e[3]}</DisplayString>
      </Synthetic>
      <Synthetic Name="[Row 3]">
        <DisplayString>{col[3].e[0]}, {col[3].e[1]}, {col[3].e[2]}, {col[3].e[3]}</DisplayString>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="IdArray&lt;*&gt;">
    <DisplayString>{{ size-ish={highest_active + 1} }}</DisplayString>
    <Expand>
      <Item Condition="first_inactive != 65535" Name="[first inactive]"> first_inactive</Item>
      <Item Condition="first_inactive == 65535" Name="[first inactive]"> "Last"</Item>
      <Item Name="[last]"> highest_active</Item>
      <Item Name="[committed]"> committed_memory_until_index</Item>
        <Synthetic Name ="[array]" IncludeView="verbose">
          <DisplayString> {committed_memory_until_index} committed elements </DisplayString>
          <Expand>
            <ArrayItems>
              <Size>committed_memory_until_index</Size>
              <ValuePointer>data</ValuePointer>
            </ArrayItems>
          </Expand>
        </Synthetic>
        <Synthetic Name ="[array]">
          <DisplayString> highest index={highest_active} </DisplayString>
          <Expand>
            <ArrayItems>
              <Size>highest_active + 1</Size>
              <ValuePointer>data</ValuePointer>
            </ArrayItems>
          </Expand>
        </Synthetic>
    </Expand>
  </Type>

  <Type Name="EntityT">
    <DisplayString> {type} </DisplayString> 
    <Expand>
        <ExpandedItem Condition="type == EntityType_Player">*(Player*)this,nd</ExpandedItem>
        <ExpandedItem Condition="type == EntityType_Camera">*(Camera*)this,nd</ExpandedItem>
        <ExpandedItem Condition="type == EntityType_ParticleSystem">*(ParticleSystem*)this,nd</ExpandedItem>
        <ExpandedItem Condition="type == EntityType_GameObject">*(GameObject*)this,nd</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="ArrayView&lt;*&gt;">
    <DisplayString> size={count} </DisplayString>
    <Expand>
        <ArrayItems>
          <Size>count</Size>
          <ValuePointer>data</ValuePointer>
        </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SysIP4">
    <DisplayString> ({(unsigned int)a,u}.{(unsigned int)b,u}.{(unsigned int)c,u}.{(unsigned int)d,u}) </DisplayString>
  </Type>

  <Type Name="SysIP4Subnet">
    <!--==============  This is stupid but it works  ===============-->
    <DisplayString Condition="mask == 0xFFFFFFFF">(/32)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFFFE">(/31)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFFFC">(/30)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFFF8">(/29)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFFF0">(/28)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFFE0">(/27)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFFC0">(/26)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFF80">(/25)</DisplayString>
    <!--============================================================-->
    <DisplayString Condition="mask == 0xFFFFFF00">(/24)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFE00">(/23)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFFC00">(/22)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFF800">(/21)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFF000">(/20)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFE000">(/19)</DisplayString>
    <DisplayString Condition="mask == 0xFFFFC000">(/18)</DisplayString>
    <DisplayString Condition="mask == 0xFFFF8000">(/17)</DisplayString>
    <!--============================================================-->
    <DisplayString Condition="mask == 0xFFFF0000">(/16)</DisplayString>
    <DisplayString Condition="mask == 0xFFFE0000">(/15)</DisplayString>
    <DisplayString Condition="mask == 0xFFFC0000">(/14)</DisplayString>
    <DisplayString Condition="mask == 0xFFF80000">(/13)</DisplayString>
    <DisplayString Condition="mask == 0xFFF00000">(/12)</DisplayString>
    <DisplayString Condition="mask == 0xFFE00000">(/11)</DisplayString>
    <DisplayString Condition="mask == 0xFFC00000">(/10)</DisplayString>
    <DisplayString Condition="mask == 0xFF800000">(/09)</DisplayString>
    <!--============================================================-->
    <DisplayString Condition="mask == 0xFF000000">(/08)</DisplayString>
    <DisplayString Condition="mask == 0xFE000000">(/07)</DisplayString>
    <DisplayString Condition="mask == 0xFC000000">(/06)</DisplayString>
    <DisplayString Condition="mask == 0xF8000000">(/05)</DisplayString>
    <DisplayString Condition="mask == 0xF0000000">(/04)</DisplayString>
    <DisplayString Condition="mask == 0xE0000000">(/03)</DisplayString>
    <DisplayString Condition="mask == 0xC0000000">(/02)</DisplayString>
    <DisplayString Condition="mask == 0x80000000">(/01)</DisplayString>
    <DisplayString Condition="mask == 0x00000000">(/00)</DisplayString>
  </Type>

  <Type Name="SysIP6">
<DisplayString> {a,x}:{b,x}:{c,x}:{d,x}:{e,x}:{f,x}:{g,x}:{h,x} </DisplayString>
  </Type>

  <Type Name="SysIP6Subnet">
    <DisplayString> (/{mask[0],b} {mask[1],b}) </DisplayString>
  </Type>

</AutoVisualizer>

